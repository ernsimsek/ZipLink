# Copy this file to .env.local and fill in real values (never commit .env.local).
#   cp .env.local.example .env.local

# Your site URL (local dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Vercel KV — copy from Vercel → Project → Settings → Environment Variables
# (or from Storage → your database → .env.local tab)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternative names (Upstash direct — only if you are NOT using Vercel KV)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
